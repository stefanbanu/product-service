<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Standalone on purpose: the pom one directory up is the Spring Boot app itself
      (packaging jar), so it cannot aggregate this directory as a <module>. Nothing
      inherits from there either, which is why versions and the Java release are
      spelled out below instead of coming from spring-boot-starter-parent.
      Build it explicitly: mvn -f liquibase/pom.xml <goal>.
    -->
    <groupId>com.banu</groupId>
    <artifactId>product-service-liquibase</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>product-service-liquibase</name>
    <description>Liquibase database migrations for product-service</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <liquibase.version>5.0.4</liquibase.version>
        <h2.version>2.5.252</h2.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-core</artifactId>
            <version>${liquibase.version}</version>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>${h2.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.liquibase</groupId>
                <artifactId>liquibase-maven-plugin</artifactId>
                <!--
                  Pinned to the same version as liquibase-core above: the plugin bundles its
                  own copy of core, and letting the two drift is how you get changelog
                  parsing differences between `mvn liquibase:update` and anything embedding
                  the library.

                  Bound to no lifecycle phase on purpose - migrations run when someone asks
                  (mvn -f liquibase/pom.xml liquibase:update), not as a side effect of a build.
                -->
                <version>${liquibase.version}</version>
                <configuration>
                    <!--
                      The last two settings that cannot live in liquibase.properties, which
                      holds everything else - url, credentials, changeLogFile.

                      searchPath has to be here because the plugin resolves the property file
                      itself through the search path: configuring it in that file would be
                      circular. Two entries, because two different things are looked up
                      through it - src/main/resources for the changelogs (the plugin's default
                      search path is the module root plus its dependency jars, so without
                      this the changelog "was not found in the configured search path"), and
                      the module root for liquibase.properties. Pointing at the sources rather
                      than target/classes keeps the goals working without a preceding
                      resource-processing build.

                      changeLogFile, set in the property file, stays relative to this search
                      path; includeAll inside the master changelog resolves against it too,
                      which is why it is declared there with relativeToChangelogFile="false".
                    -->
                    <searchPath>${project.basedir}/src/main/resources,${project.basedir}</searchPath>
                    <propertyFile>liquibase.properties</propertyFile>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
